{
  "name": "uni-constelation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Public-data research constellation pilot spanning Law and Business and Economics at the University of Basel",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "crawl": "python3 scripts/crawl.py --max-records 700",
    "crawl:law": "python3 scripts/crawl.py --org-unit 47838 --max-records 8000 --max-edoc-requests 600",
    "crawl:economics": "python3 scripts/crawl.py --org-unit 47827 --max-records 4000 --max-edoc-requests 450",
    "crawl:full": "npm run crawl:law && npm run crawl:economics",
    "graph": "python3 scripts/build_graph.py && node scripts/layout.mjs",
    "embed": "python3 scripts/embed.py",
    "validate": "python3 scripts/validate.py",
    "test": "python3 -m unittest discover -s tests -p 'test_*.py' && npm run validate",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "d3": "^7.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
